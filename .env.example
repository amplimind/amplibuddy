# Copy to .env and fill in. Without OPENROUTER_API_KEY the brain runs in
# "offline" mode: rule-based choices with canned thoughts, no LLM calls.

OPENROUTER_API_KEY=

# Frequent "what do I do next" decisions and book takeaways -> small, cheap model.
BRAIN_MODEL=anthropic/claude-haiku-5.5
# Nightly diary + notebook rewrite (once per sim day).
REFLECT_MODEL=anthropic/claude-sonnet-5.5

# Hidden "thinking" for reasoning models: off | low | medium | high.
# Off is faster and cheaper; thinking tokens are billed as output.
LLM_REASONING=off

# Internet café: real web searches via OpenRouter's web plugin (Exa, ~$0.0075 each).
WEB_SEARCH=on
WEB_SEARCHES_PER_DAY=20
# Optional, comma-separated, e.g. reddit.com,*.example.com
WEB_EXCLUDE_DOMAINS=

# Art studio: SVG artworks per day (UTC), made with REFLECT_MODEL.
ART_PER_DAY=10

# Hard spend cap per real calendar day (UTC). Over budget -> offline mode.
LLM_DAILY_BUDGET_USD=2
# Safety net against runaway loops.
LLM_MAX_CALLS_PER_HOUR=120

# Sim minutes that pass per real second. Also drives LLM cost (calls happen per sim activity).
#   0.1       = a sim day lasts 4 real hours (~2 days per workday). Default.
#   1         = a sim day lasts 24 real minutes. Handy while developing.
#   0.0166667 = real time.
SIM_MINUTES_PER_SECOND=0.1

SIM_PORT=4300
SIM_URL=http://localhost:4300

# Shared secret between brain and sim for the /api/brain/* endpoints.
# Leave empty only for local hacking.
BRAIN_TOKEN=change-me

# Enables the admin page at /admin (held letters, reports, kill switch). Empty = admin off.
ADMIN_TOKEN=
# One shared password for the whole site (browser login prompt). Set this before
# the site is reachable outside a trusted network. Brain endpoints are unaffected.
SITE_PASSWORD=
