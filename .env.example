# Copy to .env and fill in. Without OPENROUTER_API_KEY the brain runs in
# "offline" mode: rule-based choices with canned thoughts, no LLM calls.

OPENROUTER_API_KEY=

# Frequent "what do I do next" decisions and book takeaways -> small, cheap model.
BRAIN_MODEL=anthropic/claude-haiku-5.5
# Nightly diary + notebook rewrite (once per sim day).
REFLECT_MODEL=anthropic/claude-sonnet-5.5

# --- Or: a local model, free and offline (e.g. Ollama: https://ollama.com) ---
# Any OpenAI-compatible server works. Cost limits below are off for local models unless you set them.
# Free real web search on your own machine: run `npm run search:start` (local SearXNG via Docker)
# and set SEARXNG_URL=http://localhost:8888. Ampli then searches Google/Bing/DuckDuckGo through it
# and reads the best page. No account, no key, no cost. With SearXNG set, the only fallback is
# Wikipedia: nothing paid is used unless you choose it with WEB_SEARCH_PROVIDER.
# SEARXNG_URL=
# Otherwise the internet café tries, in order: Ollama web search if OLLAMA_API_KEY is set
# (needs usage credits on ollama.com, see https://ollama.com/plans), OpenRouter search if
# OPENROUTER_API_KEY is set (~$0.0075 per search, max WEB_SEARCHES_PER_DAY), then Wikipedia.
# If one fails, the next takes over. WEB_SEARCH_PROVIDER=ollama|openrouter|wikipedia forces one.
# OLLAMA_API_KEY=
# Locally one model does everything; gemma4:12b is the default (tools + vision, fits 16 GB Macs):
#   ollama pull gemma4:12b
# LLM_BASE_URL=http://localhost:11434/v1
# BRAIN_MODEL=gemma4:12b
# Only if you want something else for replies/art or for images:
# REFLECT_MODEL=
# VISION_MODEL=
# Only if your local server needs one (the OpenRouter key is never sent elsewhere).
# LLM_API_KEY=

# Hidden "thinking" for reasoning models: off | low | medium | high.
# Off is faster and cheaper; thinking tokens are billed as output.
LLM_REASONING=off

# Internet café: real web searches via OpenRouter's web plugin (Exa, ~$0.0075 each).
WEB_SEARCH=on
WEB_SEARCHES_PER_DAY=20
# Optional, comma-separated, e.g. reddit.com,*.example.com
WEB_EXCLUDE_DOMAINS=

# Art studio: SVG artworks per day (UTC), made with REFLECT_MODEL. Cost limit.
# ART_PER_DAY=10
# Chats with neighbours per day (only if a neighbour in world/neighbors is active). Cost limit.
# CHATS_PER_DAY=12
# Notes per sim day on the notice board. Unlimited by default; set a number to cap them.
# NOTES_PER_DAY=

# Cost limits (defaults shown; with a local model they're off unless set here).
# Hard spend cap per real calendar day (UTC). Over budget -> offline mode.
# LLM_DAILY_BUDGET_USD=2
# Safety net against runaway loops.
# LLM_MAX_CALLS_PER_HOUR=120

# Sim minutes that pass per real second. Also drives LLM cost (calls happen per sim activity).
#   0.1       = a sim day lasts 4 real hours (~2 days per workday). Default.
#   1         = a sim day lasts 24 real minutes. Handy while developing.
#   0.0166667 = real time.
SIM_MINUTES_PER_SECOND=0.1

SIM_PORT=4300
SIM_URL=http://localhost:4300

# Shared secret between brain and sim for the /api/brain/* endpoints.
# Leave empty only for local hacking.
BRAIN_TOKEN=change-me

# Enables the admin page at /admin (held letters, reports, kill switch). Empty = admin off.
ADMIN_TOKEN=
# One shared password for the whole site (browser login prompt). Set this before
# the site is reachable outside a trusted network. Brain endpoints are unaffected.
SITE_PASSWORD=
